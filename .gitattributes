# Line endings: let Git normalise source files, but never touch data and results,
# whose bytes must stay exactly as written (tokenizer files, model weights, CSVs).
* text=auto
*.sh text eol=lf
*.bat text eol=crlf
data/** -text
results/** -text
results_gpt2/** -text
docs/figures/** binary
*.png binary
*.jpg binary
*.npy binary
*.npz binary
*.safetensors binary
